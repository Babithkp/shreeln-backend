// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int        @id @default(autoincrement())
  userName String     @unique @default("admin")
  password String     @default("admin@123")
  branches Branches[]
}

model Branches {
  id            Int    @id @default(autoincrement())
  branchName    String @unique
  branchManager String
  contactNo     String
  address       String
  city          String
  state         String
  pincode       String
  UserName      String
  password      String
  employeeCount Int
  adminId       Int
  admin         Admin  @relation(fields: [adminId], references: [id])
}
